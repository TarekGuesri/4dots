# --------------------------------------------------
# Core
# --------------------------------------------------

# Port assigned by cPanel Node.js app (often set automatically).
PORT=3000
ENVIRONMENT=production # production or development

# Comma-separated list of allowed frontend origins (Vercel URL + custom domain).
# Example: https://4dots.vercel.app,https://yourdomain.com
CORS_ORIGINS=https://your-app.vercel.app

# --------------------------------------------------
# Secret Keys
# --------------------------------------------------

# Secret used to encrypt/decrypt the game stats token stored in the browser.
# Use a long random string in production (e.g. openssl rand -base64 32).
GAME_STATS_SECRET=game-stats-secret
