{
	"name": "4dots",
	"version": "1.0.0",
	"private": "true",
	"workspaces": [
		"packages/*"
	],
	"repository": "https://github.com/TarekGuesri/4dots.git",
	"author": "TarekGuesri <tguesri@gmail.com>",
	"license": "MIT",
	"scripts": {
		"client": "yarn workspace @4dots/client",
		"server": "yarn workspace @4dots/server",
		"start:dev": "concurrently \"yarn server start:dev\" \"yarn client start:dev\" -i --names \"server,client\"",
		"format": "prettier --write .",
		"lint": "concurrently \"yarn server lint\" \"yarn client lint\"",
		"build:client": "yarn workspace @4dots/client build",
		"build:server": "yarn workspace @4dots/server build",
		"postinstall": "yarn husky install"
	},
	"devDependencies": {
		"@commitlint/cli": "^17.6.5",
		"@commitlint/config-conventional": "^17.6.5",
		"concurrently": "^8.2.0",
		"cspell": "^5.12.6",
		"eslint-plugin-prettier": "^5.0.0",
		"husky": "^8.0.3",
		"lerna": "^7.0.0",
		"lint-staged": "^15.2.1",
		"prettier": "^3.0.0",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.6.13"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
